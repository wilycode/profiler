{
    "name": "wilycode/profiler",
    "description": "Framework-independent profiling contracts and value objects for PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Profiler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Profiler\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/CONTRIBUTING.md",
            "/CHANGELOG.md",
            "/composer.lock",
            "/AGENTS.md"
        ]
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "keywords": [
        "profiling",
        "profiler",
        "performance",
        "metrics",
        "tracing",
        "php"
    ],
    "homepage": "https://github.com/wilycode/profiler",
    "support": {
        "issues": "https://github.com/wilycode/profiler/issues",
        "source": "https://github.com/wilycode/profiler"
    },
    "suggest": {
        "wilycode/profiler-php": "PHP implementation of the profiling contracts."
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
